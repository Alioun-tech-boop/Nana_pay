# =============================================================================
# NanaPay Backend - Modèle d'environnement (à copier vers .env)
# =============================================================================
NODE_ENV=development
PORT=3000
API_PREFIX=/api

# --- Supabase PostgreSQL ---
# Récupérer dans Dashboard Supabase > Project Settings > Database > Connection string
# Pooler transaction (6543) : runtime
DATABASE_URL="postgresql://postgres.PROJECT_REF:[YOUR-PASSWORD]@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require"
# Pooler session (5432) : migrations
DIRECT_DATABASE_URL="postgresql://postgres.PROJECT_REF:[YOUR-PASSWORD]@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require"

# --- Redis ---
REDIS_URL="redis://localhost:6379"

# --- JWT RS256 (générer : openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048) ---
# Sur une seule ligne, les retours à la ligne sont échappés en \n
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# --- Argon2id ---
ARGON2_MEMORY=65536
ARGON2_TIME=3
ARGON2_PARALLELISM=1

# --- CORS ---
CORS_ORIGINS=http://localhost:5173

# --- Rate limiting ---
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# --- HMAC (min 32 caractères) ---
HMAC_SECRET="CHANGE_ME_AT_LEAST_32_CHARACTERS_LONG_RANDOM_SECRET"

# --- MFA ---
MFA_ISSUER=NanaPay
