# NanoPay — Configuration frontend (valeurs publiques uniquement)
# Aucun secret ne doit être placé ici (voir SECURITY.md §7).

# Mode d'API : "mock" (défaut, aucun backend requis) | "real" (backend réel)
VITE_NP_API_MODE=mock

# Base URL de l'API réelle (utilisée uniquement en mode "real")
VITE_NP_API_URL=

# Latence simulée des mocks (ms) — confort de développement des états LOADING
VITE_NP_MOCK_DELAY_MS=250

# Timeout de l'API réelle (ms)
VITE_NP_API_TIMEOUT_MS=15000

# Locale par défaut des messages d'erreur et formats
VITE_NP_LOCALE=fr